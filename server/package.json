{
  "name": "server",
  "version": "1.0.0",
  "type": "module",
  "main": "index.js",
  "imports": {
    "#src/*": "./src/*",
    "#s/*": "./generated/@typespec/ts-schemas/*",
    "#generated/*": "./generated/*"
  },
  "scripts": {
    "build": "rimraf dist && tsc",
    "dev": "tsx watch src/main.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prettier:check": "prettier . --check",
    "prettier:write": "prettier . --write",
    "typespec:generate": "tsp compile ./typespec",
    "typespec:generate:watch": "tsp compile ./typespec --watch",
    "typespec:generateTsSchemas": "node typespec-helper.ts --generateTsSchemas",
    "typespec": "npm run typespec:generate && npm run typespec:generateTsSchemas",
    "prisma:studio": "npx prisma studio",
    "prisma:seed": "npx prisma db seed"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/env": "^5.0.3",
    "@fastify/jwt": "^10.0.0",
    "@fastify/type-provider-json-schema-to-ts": "^5.0.0",
    "@prisma/client": "^6.19.0",
    "@typespec/openapi3": "^1.5.0",
    "ajv": "^8.17.1",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.1"
  },
  "devDependencies": {
    "@apidevtools/json-schema-ref-parser": "^14.2.1",
    "@eslint/js": "^9.39.2",
    "@types/node": "^24.5.2",
    "@typespec/http": "^1.5.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "fastify-tsconfig": "^3.0.0",
    "globals": "^16.5.0",
    "json-schema-to-ts": "^3.1.1",
    "prettier": "^3.7.4",
    "prisma": "^6.19.0",
    "rimraf": "^6.0.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.50.1"
  }
}
