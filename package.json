{
  "private": true,
  "scripts": {
    "client": "pnpm --filter @budget/frontend dev",
    "server": "pnpm --filter @budget/server dev",
    "dev": "concurrently \"pnpm run client\" \"pnpm run server\""
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "engines": {
    "pnpm": ">=9"
  },
