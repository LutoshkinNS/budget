datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "./../generated/prisma"
}

model User {
  id        BigInt   @id
  firstName String?
  photoUrl  String?
  createdAt DateTime @default(now())

  ownedAccounts Account[]     @relation("AccountOwner")
  accounts      AccountUser[]
  transactions  Transaction[]
}

model Account {
  id                 Int      @id @default(autoincrement())
  name               String
  initialBalance     Float    @default(0)
  initialBalanceDate DateTime @default(now())
  ownerId            BigInt
  owner              User     @relation("AccountOwner", fields: [ownerId], references: [id])
  createdAt          DateTime @default(now())

  users                 AccountUser[]
  transactionCategories TransactionCategory[]
  transactions          Transaction[]
  invitations           AccountInvitation[]
}

model AccountInvitation {
  id        Int       @id @default(autoincrement())
  code      String    @unique
  accountId Int
  account   Account   @relation(fields: [accountId], references: [id])
  createdBy BigInt
  expiresAt DateTime
  usedAt    DateTime?
  usedBy    BigInt?
}

model AccountUser {
  userId    BigInt
  user      User     @relation(fields: [userId], references: [id])
  accountId Int
  account   Account  @relation(fields: [accountId], references: [id])
  joinedAt  DateTime @default(now())

  @@id([userId, accountId])
}

model TransactionCategory {
  id             Int           @id @default(autoincrement())
  accountId      Int
  account        Account       @relation(fields: [accountId], references: [id])
  type           String        @default("expense")
  name           String
  iconKey        String?
  nameNormalized String
  deletedAt      DateTime?
  transactions   Transaction[]
  subcategories  Subcategory[]

  // Частичный SQL-индекс в миграциях ограничивает уникальность активных категорий.
  @@index([accountId, type, nameNormalized])
}

model Subcategory {
  id         Int                 @id @default(autoincrement())
  categoryId Int
  category   TransactionCategory @relation(fields: [categoryId], references: [id])
  name       String
  deletedAt  DateTime?
}

model Transaction {
  id          Int                 @id @default(autoincrement())
  accountId   Int
  account     Account             @relation(fields: [accountId], references: [id])
  categoryId  Int
  category    TransactionCategory @relation(fields: [categoryId], references: [id])
  userId      BigInt
  user        User                @relation(fields: [userId], references: [id])
  // Старые операции получают тип «expense», чтобы сохранить исторический смысл.
  type        String              @default("expense")
  amount      Float
  description String?
  date        DateTime

  @@index([accountId, date])
  @@index([accountId, type, date])
}
